{
  "name": "@tayzu/api",
  "version": "0.0.0",
  "private": true,
  "description": "Tayzu's first application: Fastify bootstrap mounting Better Auth and the catalog's oRPC handler.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "otel-smoke-check": "vitest run src/otel-smoke-check.int.test.ts",
    "test:unit": "vitest run --project \"*unit*\"",
    "identity:backfill-user-blueprint": "tsx scripts/backfill-user-blueprint.ts",
    "identity:reconcile-users": "tsx scripts/reconcile-users.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "contract:generate": "tsx scripts/generate-identity-contract.ts",
    "contract:check": "tsx scripts/check-identity-contract.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@orpc/openapi": "^1.15.5",
    "@orpc/server": "^1.15.5",
    "@tayzu/auth": "workspace:*",
    "@tayzu/authz": "workspace:*",
    "@tayzu/catalog": "workspace:*",
    "@tayzu/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
