{
  "name": "@tayzu/api",
  "version": "0.0.0",
  "private": true,
  "description": "Tayzu's first application: Fastify bootstrap mounting Better Auth and the catalog's oRPC handler.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "otel-smoke-check": "vitest run src/otel-smoke-check.int.test.ts",
    "test:unit": "vitest run --project \"*unit*\""
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@orpc/openapi": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@tayzu/auth": "workspace:*",
    "@tayzu/authz": "workspace:*",
    "@tayzu/catalog": "workspace:*",
    "@tayzu/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
