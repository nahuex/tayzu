{
  "name": "@tayzu/web",
  "version": "0.0.0",
  "private": true,
  "description": "Tayzu's web app: the single-page catalog UI, served same-origin by @tayzu/api.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle": "tsx src/build-check/check-bundle.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project \"*unit*\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@orpc/client": "1.15.4",
    "@orpc/openapi-client": "1.15.4",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "@tayzu/catalog": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "get-nonce": "1.0.1",
    "i18next": "26.7.1",
    "lucide-react": "1.68.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.12",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0"
  }
}
