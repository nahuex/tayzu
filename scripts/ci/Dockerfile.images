# Pinned image digests used by scripts/ci/dast.sh. Never built: it exists so
# Dependabot's `docker` ecosystem (.github/dependabot.yml) can read and bump
# the pins, and dast.sh reads the FROM lines from here (task 13.12).
FROM postgres:18@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc AS postgres
FROM ghcr.io/zaproxy/zaproxy@sha256:9624669db72f54d86c4b46a7064518bd9bf79d8c61a4c31befa9923489f328af AS zap
