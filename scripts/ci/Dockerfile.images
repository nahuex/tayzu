# Pinned image digests used by scripts/ci/dast.sh. Never built: it exists so
# Dependabot's `docker` ecosystem (.github/dependabot.yml) can read and bump
# the pins, and dast.sh reads the FROM lines from here (task 13.12).
FROM postgres:16@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54 AS postgres
FROM ghcr.io/zaproxy/zaproxy@sha256:7aaa659b0d43078febd82e29bad112285c370727e86ab8340444220e17d9f0d2 AS zap
