{
  "name": "@tayzu/observability",
  "version": "0.0.0",
  "private": true,
  "description": "OpenTelemetry test harness and SDK bootstrap helper for Tayzu packages.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./semconv": "./src/semconv.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project \"*unit*\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  }
}
